---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "HaloAfid — Digital Studio | Website, Sistem Informasi, SEO & GEO, AI",
  description = "HaloAfid adalah personal brand milik Afid dari Indonesia — bukan cuma bikin web biar kelihatan profesional, tapi bikin workflow bisnis lebih mudah dan efisien lewat website, sistem informasi, SEO & GEO, dan AI.",
} = Astro.props;

const ogImage = new URL("/og-image.svg", Astro.site ?? "https://haloafid.site");
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://haloafid.site");
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <!-- Fonts: Space Grotesk + Inter + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Theme -->
    <meta name="theme-color" content="#f6f6f4" />
    <meta name="color-scheme" content="light" />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      name: site.name,
      url: "https://haloafid.site",
      email: site.email,
      telephone: "+6282136006831",
      description,
      areaServed: "ID",
      priceRange: "$$",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Mangir, Sendangsari, Pajangan",
        addressLocality: "Bantul",
        addressRegion: "DI Yogyakarta",
        addressCountry: "ID",
      },
      sameAs: [site.tiktok, site.instagram, site.threads],
    })} />
  </head>
  <body>
    <div class="cursor-dot" data-cursor-dot aria-hidden="true"></div>
    <div class="cursor-ring" data-cursor-ring aria-hidden="true"></div>
    <slot />
    <script>
      // Detect fine pointer → enable custom cursor classes (progressive enhancement)
      if (window.matchMedia("(pointer: fine)").matches) {
        document.body.classList.add("has-cursor");
      }
    </script>
  </body>
</html>