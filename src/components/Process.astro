---
const steps = [
  {
    num: "01",
    title: "Discover",
    desc: "Diskusi kebutuhan, tujuan, dan masalah yang ingin diselesaikan.",
    dur: "1–2 hari",
  },
  {
    num: "02",
    title: "Design",
    desc: "Struktur, konten, dan desain — cepat, jelas, dan sesuai brand.",
    dur: "3–5 hari",
  },
  {
    num: "03",
    title: "Build",
    desc: "Pengembangan dengan standar teknis tinggi, diuji di setiap tahap.",
    dur: "1–3 minggu",
  },
  {
    num: "04",
    title: "Launch",
    desc: "Deploy, optimasi, dan dukungan lanjutan agar terus berjalan lancar.",
    dur: "Berkelanjutan",
  },
];
---

<section id="process" class="py-24 md:py-32 bg-white border-y border-[var(--color-line)]">
  <div class="container-site">
    <div class="mb-14">
      <p class="kicker mb-4" data-reveal>Proses Kerja</p>
      <h2 class="display-section text-4xl md:text-5xl" data-reveal style="--reveal-delay:0.08s">
        Jelas dari <span class="text-[var(--color-accent)]">awal.</span>
      </h2>
    </div>

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {steps.map((s, i) => (
        <div
          class="card group relative p-7 overflow-hidden transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[var(--shadow-lift)]"
          data-process-step
          data-reveal
          style={`--reveal-delay:${i * 0.1}s`}
        >
          <div class="absolute -right-6 -top-8 display-hero text-[7rem] leading-none text-[var(--color-canvas)] transition-colors duration-300 group-hover:text-[var(--color-accent-soft)] select-none" aria-hidden="true">0{i + 1}</div>
          <div class="relative">
            <div class="mb-6 flex items-center justify-between">
              <span class="tag">{s.dur}</span>
            </div>
            <h3 class="display-section text-2xl mb-2.5">{s.title}</h3>
            <p class="text-sm leading-relaxed text-[var(--color-ink-soft)]">{s.desc}</p>
            <div class="mt-6 h-1 w-full rounded-full bg-[var(--color-canvas)] overflow-hidden">
              <div class="h-full w-0 rounded-full bg-[var(--color-accent)] transition-all duration-700 group-hover:w-full"></div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>