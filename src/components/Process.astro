---
const steps = [
  {
    num: "01",
    title: "Discover",
    desc: "Diskusi kebutuhan, tujuan, dan masalah yang ingin diselesaikan.",
    dur: "1–2 hari",
    color: "nb-yellow",
  },
  {
    num: "02",
    title: "Design",
    desc: "Struktur, konten, dan desain — cepat, jelas, dan sesuai brand.",
    dur: "3–5 hari",
    color: "nb-blue",
  },
  {
    num: "03",
    title: "Build",
    desc: "Pengembangan dengan standar teknis tinggi, diuji di setiap tahap.",
    dur: "1–3 minggu",
    color: "nb-pink",
  },
  {
    num: "04",
    title: "Launch",
    desc: "Deploy, optimasi, dan dukungan lanjutan agar terus berjalan lancar.",
    dur: "Berkelanjutan",
    color: "nb-green",
  },
];
---

<section id="process" class="py-24 md:py-32 overflow-hidden">
  <div class="container-site mb-12 flex flex-wrap items-end justify-between gap-6">
    <div>
      <p class="kicker mb-4" data-reveal>Proses Kerja</p>
      <h2 class="display-section text-4xl md:text-5xl" data-scrub data-reveal style="--reveal-delay:0.08s">
          <span class="scrub-mask"><span class="scrub-word">Jelas</span></span>{" "}
          <span class="scrub-mask"><span class="scrub-word">dari</span></span>{" "}
          <span class="scrub-mask"><span class="scrub-word text-[var(--color-accent)]">awal.</span></span>
        </h2>
    </div>
    <p class="max-w-sm text-sm text-[var(--color-muted)]" data-reveal style="--reveal-delay:0.15s">
      Geser — scroll untuk menjelajahi tiap tahap kerja kami.
    </p>
  </div>

  <!-- Horizontal scroll pinned -->
  <div class="h-scroll" data-h-scroll>
    <div class="h-track" data-h-track>
      {steps.map((s, i) => (
        <div class="h-panel">
          <div
            class={`nb-card ${s.color} p-8 h-full flex flex-col min-h-[340px]`}
            data-tilt3d
          >
            <div class="tilt-glare"></div>
            <div class="flex items-start justify-between mb-10">
              <span class="font-[var(--font-display)] text-6xl font-bold leading-none">{s.num}</span>
              <span class="nb-tag">{s.dur}</span>
            </div>
            <div class="mt-auto">
              <h3 class="font-[var(--font-display)] text-2xl font-bold mb-3">{s.title}</h3>
              <p class="text-[0.95rem] leading-relaxed text-[var(--color-ink)]/80">{s.desc}</p>
            </div>
            <div class="mt-6 h-2 w-full rounded-sm bg-[var(--color-ink)]/10 overflow-hidden">
              <div class="h-full w-0 bg-[var(--color-ink)] transition-all duration-500 group-hover:w-full" data-process-bar></div>
            </div>
          </div>
        </div>
      ))}
      <!-- End panel -->
      <div class="h-panel">
        <div class="nb-card nb-cream p-8 h-full flex flex-col items-center justify-center text-center min-h-[340px]">
          <p class="font-[var(--font-display)] text-3xl font-bold leading-tight mb-4">
            Ada project<br />yang cocok?
          </p>
          <a href="#contact" class="nb-btn nb-btn-dark mt-2" data-magnetic>Mari bicara →</a>
        </div>
      </div>
    </div>
  </div>
</section>