---
const steps = [
  {
    num: "01",
    title: "Discover",
    desc: "Memahami bisnis, kebutuhan, masalah, dan target.",
  },
  {
    num: "02",
    title: "Design",
    desc: "Menyusun struktur, experience, visual, dan prioritas.",
  },
  {
    num: "03",
    title: "Build",
    desc: "Mengembangkan website/sistem dengan teknologi yang sesuai.",
  },
  {
    num: "04",
    title: "Launch & Improve",
    desc: "Testing, deployment, handover, lalu iterasi ketika dibutuhkan.",
  },
];
---

<section id="process" class="py-28 md:py-40 border-t border-line bg-surface/30">
  <div class="container-site">
    <div class="max-w-3xl mb-16">
      <p class="kicker mb-4" data-reveal>PROCESS</p>
      <h2 class="display-section text-text-primary" data-reveal>
        How we take an idea to launch.
      </h2>
    </div>

    <div class="space-y-0" data-process>
      {
        steps.map((step) => (
          <div class="grid md:grid-cols-12 gap-4 py-10 border-b border-line items-baseline group" data-process-step>
            <div class="md:col-span-2">
              <span class="display-section text-text-muted/40 group-hover:text-electric transition-colors">
                {step.num}
              </span>
            </div>
            <div class="md:col-span-4">
              <h3 class="text-2xl md:text-3xl font-semibold tracking-tight">
                {step.title}
              </h3>
            </div>
            <div class="md:col-span-6">
              <p class="text-text-secondary max-w-lg">{step.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>