---
import { site } from "../data/site";
const stats = [
  { value: 5, suffix: "+", label: "tahun pengalaman" },
  { value: 30, suffix: "+", label: "project kelar" },
  { value: 100, suffix: "%", label: "customer happy" },
];
const highlights = ["WEBSITE", "SISTEM INFO", "SEO & GEO", "SOLUSI AI", "SUPPORT"];
---

<section id="top" class="relative overflow-hidden pt-28 md:pt-36 pb-12">
  <!-- Moving pattern bg -->
  <div class="absolute inset-0 -z-10" aria-hidden="true" data-parallax="0.18"
    style="background-image:url('/images/pattern.svg'); background-size:220px 220px; opacity:0.16;"
  ></div>

  <div class="container-site">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-2xl min-w-0">
        <div class="flex flex-wrap items-center gap-3 mb-7" data-reveal>
          <span class="tag !bg-[var(--color-yellow)]">🇮🇩 Indonesia</span>
          <span class="tag !bg-white">💼 30+ project kelar</span>
          <span class="tag !bg-[var(--color-green)]">🤝 Ngobrol dulu, gratis</span>
        </div>

        <h1 class="display-hero text-[12vw] sm:text-5xl md:text-6xl xl:text-[4.3rem]">
          <span class="hero-3d"><span class="hero-3d-in">Bukan cuma</span></span>
          <span class="hero-3d"><span class="hero-3d-in">kelihatan,</span></span>
          <span class="hero-3d"><span class="hero-3d-in">tapi beneran</span></span>
          <span class="hero-3d">
            <span class="hero-3d-in relative inline-block">
              <span class="relative z-[1] text-[var(--color-accent)]">profesional.</span>
              <svg class="absolute -bottom-2 left-0 w-full z-0" viewBox="0 0 200 14" aria-hidden="true"><path d="M3 10C50 3 150 3 197 10" stroke="#ffd43b" stroke-width="5" fill="none" stroke-linecap="round"/></svg>
            </span>
          </span>
        </h1>

        <p class="mt-5 max-w-xl text-lg leading-relaxed text-[var(--color-ink-soft)]" data-reveal style="--reveal-delay:0.2s">
          Fokus saya bukan bikin web biar kelihatan profesional doang.
          Tapi bikin workflow bisnismu lebih gampang dan efisien — orderan ketata,
          data rapi, kerjaan berulang kepangkas. Website, sistem, sampai AI yang beneran kepake harian.
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-4" data-reveal style="--reveal-delay:0.3s">
          <a href="#work" class="btn btn-primary" data-magnetic>
            🔥 Lihat hasilnya
          </a>
          <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-dark" data-magnetic>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Chat WhatsApp
          </a>
        </div>
      </div>

      <!-- Visual kanan (desktop saja): kolase gambar + animasi -->
      <aside class="relative hidden w-[340px] shrink-0 select-none lg:block xl:w-[380px]" data-reveal="scale" style="--reveal-delay:0.25s" aria-label="Contoh hasil kerja">
        <!-- Bentuk dekoratif belakang -->
        <div class="absolute -top-10 -right-4 h-44 w-44 rounded-3xl border-2 border-[var(--color-ink)] bg-[var(--color-yellow)] rotate-6" data-float aria-hidden="true"></div>
        <div class="absolute -bottom-8 -left-8 h-28 w-28 rounded-full border-2 border-[var(--color-ink)] bg-[var(--color-pink)]" data-float aria-hidden="true"></div>
        <div class="absolute top-1/2 -right-8 h-16 w-16 rotate-45 border-2 border-[var(--color-ink)] bg-[var(--color-green)]" data-float aria-hidden="true"></div>

        <!-- Kartu utama -->
        <div class="card relative z-[1] -rotate-2 overflow-hidden bg-white" data-water data-parallax-img>
          <div data-img-reveal>
            <img src="/images/kampung-mangir-digital.svg" alt="Contoh website profil digital" class="h-52 w-full object-cover" loading="eager" />
          </div>
          <div class="flex items-center justify-between border-t-2 border-[var(--color-ink)] px-4 py-3">
            <span class="tag !bg-[var(--color-green)]">Website</span>
            <span class="text-xs font-bold text-[var(--color-ink-soft)]">Kampung Mangir ↗</span>
          </div>
        </div>

        <!-- Kartu kecil menumpuk -->
        <div class="card relative z-[2] ml-auto -mt-10 mr-4 w-60 rotate-3 overflow-hidden !bg-[var(--color-sky)]" data-water data-float>
          <img src="/images/faast-penerbangan.svg" alt="Contoh website edukasi" class="h-28 w-full object-cover" loading="lazy" />
          <p class="border-t-2 border-[var(--color-ink)] bg-white px-4 py-2.5 text-xs font-bold">FAAST Penerbangan ✈️</p>
        </div>

        <!-- Chip melayang -->
        <span class="tag absolute -left-8 top-8 z-[3] !bg-white" data-float>⚡ Respon 1×24 jam</span>
        <span class="tag absolute -right-3 bottom-20 z-[3] !bg-[var(--color-yellow)]" data-float>✅ Workflow beres</span>
      </aside>
    </div>

    <!-- Stats -->
    <div class="mt-10 grid grid-cols-3 gap-4" data-reveal style="--reveal-delay:0.35s">
      {stats.map((s, i) => (
        <div class={`card card-hover ${i === 0 ? "!bg-[var(--color-yellow)]" : i === 1 ? "!bg-white" : "!bg-[var(--color-green)]"} px-5 py-4 text-center`} data-water>
          <span class="display-hero block text-3xl">
            <span data-counter={s.value}>0</span>
            <span class="text-[var(--color-accent)]">{s.suffix}</span>
          </span>
          <span class="mt-1 block text-[0.68rem] font-bold uppercase tracking-wider text-[var(--color-ink-soft)]">{s.label}</span>
        </div>
      ))}
    </div>

    <!-- Highlight strip -->
    <div class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-3 border-y-2 border-[var(--color-ink)] py-4" data-reveal style="--reveal-delay:0.4s">
      <span class="text-sm font-bold uppercase tracking-wider">Yang bisa dibantu:</span>
      <div class="flex flex-wrap gap-2">
        {highlights.map((h) => (
          <span class="tag">{h}</span>
        ))}
      </div>
      <span class="ml-auto hidden md:inline text-sm font-semibold text-[var(--color-muted)]">✨ Fokus: workflow gampang, hemat waktu.</span>
    </div>
  </div>
</section>