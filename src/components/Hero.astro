---
import { site } from "../data/site";
const stats = [
  { value: 30, suffix: "+", label: "Project delivered" },
  { value: 100, suffix: "%", label: "Client satisfaction" },
  { value: 24, suffix: "/7", label: "Reliable support" },
];
const highlights = ["WEBSITE", "SISTEM INFORMASI", "SEO & GEO", "SOLUSI AI"];
---

<section id="top" class="relative overflow-hidden pt-36 md:pt-44 pb-16 md:pb-24">
  <!-- Soft background orbs -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -top-32 -left-24 h-[480px] w-[480px] rounded-full bg-[#dbe7ff] blur-[110px] opacity-70" data-parallax="-0.1"></div>
    <div class="absolute top-40 -right-32 h-[420px] w-[420px] rounded-full bg-[#e3f3ff] blur-[110px] opacity-70" data-parallax="0.12"></div>
    <div class="absolute bottom-0 left-1/3 h-[360px] w-[360px] rounded-full bg-[#f3ecff] blur-[110px] opacity-50" data-parallax="-0.08"></div>
    <!-- subtle grid -->
    <div
      class="absolute inset-0 opacity-[0.35]"
      style="background-image: linear-gradient(to right, rgba(17,18,20,0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(17,18,20,0.04) 1px, transparent 1px); background-size: 64px 64px;"
    ></div>
  </div>

  <div class="container-site">
    <div class="flex flex-col items-start gap-12 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-4xl">
        <p class="kicker mb-6" data-reveal>HaloAfid — Digital Studio</p>
        <h1 class="display-hero text-[13vw] sm:text-6xl md:text-7xl xl:text-[5.4rem]" data-split-hero>
          <span class="split-mask"><span class="split-word text-[var(--color-ink)]">Kami</span></span>
          <span class="split-mask"><span class="split-word text-[var(--color-ink)]">membangun</span></span>
          <span class="split-mask"><span class="split-word text-[var(--color-accent)]">digital</span></span>
          <span class="split-mask"><span class="split-word text-[var(--color-ink)]">yang</span></span>
          <span class="split-mask"><span class="split-word text-[var(--color-accent)]">bekerja.</span></span>
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-[var(--color-ink-soft)]" data-reveal style="--reveal-delay:0.15s">
          Website, sistem informasi, SEO &amp; GEO, dan AI untuk bisnis yang ingin
          tumbuh lebih cepat dan bekerja lebih rapi.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-4" data-reveal style="--reveal-delay:0.25s">
          <a href="#work" class="btn btn-primary" data-magnetic>
            Lihat karya
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
          </a>
          <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-ghost" data-magnetic>
            Diskusi via WhatsApp
          </a>
        </div>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-3 gap-6 lg:gap-10" data-reveal style="--reveal-delay:0.35s">
        {stats.map((s) => (
          <div class="flex flex-col gap-1">
            <span class="display-hero text-3xl md:text-4xl text-[var(--color-ink)]">
              <span data-counter={s.value}>{0}</span>
              <span class="text-[var(--color-accent)]">{s.suffix}</span>
            </span>
            <span class="text-xs uppercase tracking-wider text-[var(--color-muted)]">{s.label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom highlight strip -->
    <div class="mt-16 md:mt-20 flex flex-wrap items-center gap-x-6 gap-y-3 border-y border-[var(--color-line)] py-5" data-reveal style="--reveal-delay:0.4s">
      <span class="text-sm font-medium text-[var(--color-muted)]">Fokus kami:</span>
      <div class="flex flex-wrap gap-2">
        {highlights.map((h) => (
          <span class="tag">{h}</span>
        ))}
      </div>
      <span class="ml-auto hidden md:inline text-sm text-[var(--color-muted)]">Based in Indonesia — available for selected projects</span>
    </div>
  </div>
</section>