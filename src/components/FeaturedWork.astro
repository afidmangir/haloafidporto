---
import { projects } from "../data/projects";
const featured = projects.slice(0, 3);
---

<section id="work" class="py-28 md:py-40">
  <div class="container-site">
    <div class="flex flex-wrap items-end justify-between gap-6 mb-16">
      <div>
        <p class="kicker mb-4" data-reveal>SELECTED WORK</p>
        <h2 class="display-section text-text-primary" data-reveal>
          Work that moves<br />business forward.
        </h2>
      </div>
      <p class="body-large max-w-sm" data-reveal>
        Proyek pilihan — dari website, sistem informasi, hingga eksperimen AI dan SEO.
      </p>
    </div>

    <div class="space-y-20 md:space-y-28">
      {
        featured.map((project, i) => (
          <article
            class="grid md:grid-cols-12 gap-8 items-center group"
            data-project-card
          >
            <div class={`md:col-span-7 ${i % 2 === 1 ? "md:order-2" : ""}`}>
              <a
                href={project.image}
                class="block overflow-hidden rounded-2xl border border-line bg-surface"
                aria-label={`${project.title} — ${project.category}`}
              >
                <img
                  src={project.image}
                  alt={project.title}
                  width="1200"
                  height="800"
                  loading={i === 0 ? "eager" : "lazy"}
                  class="w-full aspect-[3/2] object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                />
              </a>
            </div>
            <div class={`md:col-span-5 ${i % 2 === 1 ? "md:order-1" : ""}`}>
              <p class="kicker mb-3" data-reveal>{project.category}</p>
              <h3
                class="text-3xl md:text-4xl font-semibold tracking-tight leading-[1.05] mb-4"
                data-reveal
              >
                {project.title}
              </h3>
              <p class="body-large mb-6" data-reveal>{project.description}</p>
              <div class="flex flex-wrap gap-2 mb-8" data-reveal>
                {
                  project.services.map((s) => (
                    <span class="kicker !text-text-secondary border border-line rounded-full px-3 py-1">
                      {s}
                    </span>
                  ))
                }
                {project.status === "placeholder" && (
                  <span class="kicker !text-text-muted border border-dashed border-line rounded-full px-3 py-1">
                    sample
                  </span>
                )}
              </div>
              <a
                href={project.image}
                class="inline-flex items-center gap-2 text-sm font-semibold text-electric hover:text-bright transition-colors"
                data-reveal
              >
                View case<span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>