---
import { projects } from "../data/projects";
---

<section id="work-archive" class="py-24 md:py-32">
  <div class="container-site">
    <div class="mb-14">
      <p class="kicker mb-4" data-reveal>Semua Project</p>
      <h2 class="display-section text-4xl md:text-5xl" data-reveal style="--reveal-delay:0.08s">
        Arsip <span class="text-[var(--color-accent)]">karya.</span>
      </h2>
    </div>

    <div class="space-y-5">
      {projects.map((p, i) => (
        <article
          class="card group flex flex-col md:flex-row md:items-center gap-6 md:gap-8 p-5 md:p-6 overflow-hidden transition-all duration-300 hover:shadow-[var(--shadow-lift)]"
          data-reveal
          style={`--reveal-delay:${Math.min(i * 0.05, 0.2)}s`}
        >
          <div class="project-img w-full md:w-56 shrink-0 rounded-xl overflow-hidden aspect-[16/10]">
            <img src={p.image} alt={p.title} loading="lazy" class="h-full w-full object-cover" />
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class="tag">{p.category}</span>
              {p.services.map((s) => (
                <span class="tag">{s}</span>
              ))}
            </div>
            <h3 class="display-section text-2xl group-hover:text-[var(--color-accent)] transition-colors duration-300">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-soft)] line-clamp-2">{p.description}</p>
          </div>
          <div class="hidden md:grid h-12 w-12 shrink-0 place-items-center rounded-full border border-[var(--color-line)] text-[var(--color-ink-soft)] transition-all duration-300 group-hover:bg-[var(--color-accent)] group-hover:border-[var(--color-accent)] group-hover:text-white">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
          </div>
        </article>
      ))}
    </div>
    <p class="mt-8 text-sm text-[var(--color-muted)]" data-reveal>
      * Project di atas adalah karya terpilih. Punya kebutuhan serupa?{" "}
      <a href="#contact" class="link-line text-[var(--color-accent)] font-medium">Diskusikan dengan kami</a>.
    </p>
  </div>
</section>