---
import { services } from "../data/services";
---

<section id="services" class="py-28 md:py-40 border-t border-line">
  <div class="container-site">
    <div class="max-w-3xl mb-20">
      <p class="kicker mb-4" data-reveal>CAPABILITIES</p>
      <h2 class="display-section text-text-primary" data-reveal>
        From first idea to useful digital product.
      </h2>
    </div>

    <div class="border-t border-line">
      {
        services.map((service, i) => (
          <div
            class="group grid md:grid-cols-12 gap-6 py-10 md:py-12 border-b border-line items-baseline"
            data-service-row
          >
            <div class="md:col-span-2">
              <span class="kicker">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <div class="md:col-span-4">
              <h3 class="text-3xl md:text-4xl font-semibold tracking-tight group-hover:text-electric transition-colors">
                {service.title}
              </h3>
            </div>
            <div class="md:col-span-5">
              <p class="text-text-secondary leading-relaxed">
                {service.description}
              </p>
            </div>
            <div class="md:col-span-1 flex justify-start md:justify-end">
              <span class="text-electric opacity-0 group-hover:opacity-100 transition-opacity" aria-hidden="true">
                →
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>