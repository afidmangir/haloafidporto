---
import { services } from "../data/services";

const emojis: Record<string, string> = {
  website: "🌐",
  systems: "🗂️",
  search: "🔍",
  ai: "🤖",
};
const colors = ["!bg-[var(--color-yellow)]", "!bg-[var(--color-green)]", "!bg-[var(--color-pink)]", "!bg-[var(--color-sky)]"];
---

<section id="services" class="py-24 md:py-32">
  <div class="container-site">
    <div class="mb-14 flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="kicker mb-4" data-reveal>Layanan saya</p>
        <h2 class="display-section text-4xl md:text-5xl" data-scrub data-reveal style="--reveal-delay:0.08s">
          <span class="scrub-mask"><span class="scrub-word">Bisa</span></span>{" "}
          <span class="scrub-mask"><span class="scrub-word">bantu</span></span>{" "}
          <span class="scrub-mask"><span class="scrub-word text-[var(--color-accent)]">apa?</span></span>
        </h2>
      </div>
      <p class="max-w-xs text-sm font-medium text-[var(--color-muted)]" data-reveal style="--reveal-delay:0.15s">
        Semua dikerjakan fokus ke hasil bisnismu — nggak ada template asal jadi.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {services.map((s, i) => (
        <article
          class={`card card-hover ${colors[i % 4]} group relative p-7 md:p-9`}
          data-tilt3d
          data-reveal
          style={`--reveal-delay:${i * 0.08}s`}
        >
          <div class="tilt-glare"></div>
          <div class="flex items-start justify-between mb-6">
            <span class="text-4xl" aria-hidden="true">{emojis[s.id]}</span>
            <span class="tag !bg-white">0{i + 1}</span>
          </div>
          <h3 class="display-section text-2xl mb-3">{s.title}</h3>
          <p class="text-[0.95rem] leading-relaxed text-[var(--color-ink-soft)]">{s.description}</p>
          <div class="mt-7 inline-flex items-center gap-2 font-[var(--font-display)] text-sm font-bold uppercase tracking-wide">
            <a href="#contact" class="link-line">Mau kayak gini? 😄</a>
            <span class="transition-transform duration-300 group-hover:translate-x-1.5">→</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>