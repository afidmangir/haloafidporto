---
import { site } from "../data/site";
---

<section id="contact" class="py-32 md:py-48 relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div
      class="absolute bottom-[-30%] left-1/2 -translate-x-1/2 w-[90vmax] h-[90vmax] rounded-full"
      style="background: radial-gradient(circle at center, rgba(37,99,255,0.14) 0%, transparent 60%);"
    ></div>
  </div>

  <div class="container-site relative text-center">
    <p class="kicker mb-6" data-reveal>FINAL CTA</p>
    <h2 class="display-section text-text-primary max-w-5xl mx-auto" data-reveal>
      Punya ide? Mari bikin jadi <span class="text-electric">digital.</span>
    </h2>
    <p class="body-large max-w-2xl mx-auto mt-8" data-reveal>
      Ceritakan kebutuhanmu. Website, sistem, SEO &amp; GEO, atau AI — kita
      mulai dari masalahnya, bukan dari teknologinya.
    </p>

    <div class="mt-12 flex flex-wrap justify-center gap-4" data-reveal>
      <a
        href={site.whatsapp}
        target="_blank"
        rel="noopener"
        class="px-9 py-4 rounded-full bg-electric text-white font-semibold text-lg hover:bg-bright transition-colors shadow-[0_0_40px_rgba(37,99,255,0.35)]"
      >
        Chat via WhatsApp →
      </a>
    </div>

    <div class="mt-10 flex flex-wrap justify-center gap-x-10 gap-y-3 text-sm text-text-secondary" data-reveal>
      <a href={`tel:+62${site.phone.slice(1)}`} class="hover:text-electric transition-colors">
        {site.phone}
      </a>
      <a href={`mailto:${site.email}`} class="hover:text-electric transition-colors">
        {site.email}
      </a>
    </div>
  </div>
</section>