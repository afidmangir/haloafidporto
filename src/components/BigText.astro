---
// Big scrolling statement with parallax + sticky
const line1 = "Website bukan sekadar";
const line2 = "hiasan digital.";
---

<section class="py-24 md:py-36 overflow-hidden" data-bigtext-section>
  <div class="container-site">
    <div class="bigtext" data-bigtext>
      <span class="block" data-big-line="0">
        <span class="text-outline">{line1}</span>
      </span>
      <span class="block text-[var(--color-accent)]" data-big-line="1">
        {line2}
        <span class="align-middle inline-block ml-5 text-[0.9em]">👇</span>
      </span>
    </div>
    <p class="mt-8 max-w-lg text-lg text-[var(--color-ink-soft)]" data-reveal>
      Website yang bagus harus <strong>bantu bisnismu jalan</strong> — dapet
      leads, naikin kepercayaan, dan bikin pelanggan gampang nemuin kamu.
      Nggak ada drama, yang ada progress.
    </p>
  </div>
</section>