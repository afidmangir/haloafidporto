---
const items = ["Website Cepat", "Sistem Informasi", "SEO & GEO", "Solusi AI", "Desain Modern", "Mobile-First"];
---

<section class="border-y border-[var(--color-line)] bg-white py-5 overflow-hidden" aria-hidden="true">
  <div class="marquee">
    <div class="marquee-track">
      {[0, 1].map((copy) => (
        <div class="flex shrink-0 items-center">
          {items.map((item) => (
            <span class="flex items-center gap-8 px-8 text-sm font-medium uppercase tracking-[0.2em] text-[var(--color-ink-soft)]">
              {item}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="text-[var(--color-accent)]"><path d="M12 2v20M2 12h20"/></svg>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>