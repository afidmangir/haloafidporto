---
const principles = [
  { num: "01", title: "Praktis", desc: "Santai ngobrol, hasil rapi. No setengah-setengah." },
  { num: "02", title: "Hasil", desc: "Cantik saja tak cukup — harus bawa leads & order." },
  { num: "03", title: "Cepat", desc: "No lemot. Performa prioritas dari hari pertama." },
  { num: "04", title: "Jelas", desc: "Update rutin, biaya terang, tenggat realistis." },
];
const colors = ["!bg-[var(--color-yellow)]", "!bg-[var(--color-green)]", "!bg-[var(--color-pink)]", "!bg-[var(--color-sky)]"];
---

<section id="about" class="py-16 md:py-20">
  <div class="container-site">
    <div class="max-w-3xl">
      <p class="kicker mb-3" data-reveal data-i18n="about.kicker">Kenapa saya</p>
      <h2 class="display-section text-[2rem] md:text-[2.6rem] leading-none" data-scrub data-reveal data-words="about.h" style="--reveal-delay:0.06s">
        <span class="scrub-mask"><span class="scrub-word">Bisnis</span></span>{" "}
        <span class="scrub-mask"><span class="scrub-word">kamu</span></span>{" "}
        <span class="scrub-mask"><span class="scrub-word text-[var(--color-accent)]">prioritas.</span></span>
      </h2>
      <p class="mt-4 max-w-[60ch] text-[1.02rem] leading-relaxed text-[var(--color-ink-soft)]" data-reveal style="--reveal-delay:0.1s">
        <span data-i18n="about.intro1">Website, toko online, sampai sistem kasir — </span><strong data-i18n="about.intro2">langsung sama yang ngerjain.</strong><span data-i18n="about.intro3"> Update jelas, biaya transparan, kamu fokus jualan.</span>
      </p>
    </div>
  </div>

  <!-- Prinsip — versi ringkas: sticky kompak (bukan 100vh) -->
  <div class="mt-10 overlap-stack-compact" data-overlap-full>
    {principles.map((p, i) => (
      <div class={`overlap-compact ${colors[i]}`} data-overlap-card style={`z-index:${10 + i};`}>
        <div class="overlap-shade" data-overlap-shade aria-hidden="true"></div>
        <div class="overlap-compact-inner">
          <div class="flex gap-5 md:gap-8 items-start">
            <div class="shrink-0 text-center">
              <span class="display-hero block text-5xl md:text-6xl leading-none">{p.num}</span>
              <span class="tag !bg-white mt-2 !px-2 !py-1 !text-[0.6rem]" data-i18n="about.principleBadge">Prinsip</span>
            </div>
            <div class="min-w-0 pt-1">
              <h3 class="display-section text-xl md:text-2xl" data-i18n={`about.p${i+1}Title`}>{p.title}</h3>
              <p class="mt-2 text-sm md:text-[0.95rem] leading-relaxed text-[var(--color-ink-soft)]" data-i18n={`about.p${i+1}Desc`}>{p.desc}</p>
            </div>
            <span class="ml-auto hidden md:block font-[var(--font-display)] text-7xl font-bold leading-none text-[var(--color-ink)]/10 select-none" aria-hidden="true">{p.num}</span>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
