---
const principles = [
  {
    num: "01",
    title: "Santai, bukan asal",
    desc: "Ngobrolnya santai, tapi outputnya serius dan rapi. Nggak ada setengah-setengah.",
  },
  {
    num: "02",
    title: "Fokus ke hasil",
    desc: "Bukan cuma cantik. Website harus bantu bisnismu — dapat leads, pesanan, kepercayaan.",
  },
  {
    num: "03",
    title: "Cepat itu wajib",
    desc: "Nggak ada yang sabar buka website lemot. Performa sudah jadi harga mati dari awal.",
  },
  {
    num: "04",
    title: "Jujur & jelas",
    desc: "Progress di-update, biaya transparan, tenggat realistis. Nggak ada janji muluk.",
  },
];
const colors = ["!bg-[var(--color-yellow)]", "!bg-[var(--color-green)]", "!bg-[var(--color-pink)]", "!bg-[var(--color-sky)]"];
---

<section id="about" class="py-24 md:py-32">
  <div class="container-site">
    <p class="kicker mb-4" data-reveal>Tentang kita</p>
    <h2 class="display-section text-4xl md:text-5xl" data-scrub data-reveal style="--reveal-delay:0.08s">
      <span class="scrub-mask"><span class="scrub-word">Studio</span></span>{" "}
      <span class="scrub-mask"><span class="scrub-word">kecil,</span></span>{" "}
      <span class="scrub-mask"><span class="scrub-word text-[var(--color-accent)]">hasil</span></span>{" "}
      <span class="scrub-mask"><span class="scrub-word">gede.</span></span>
    </h2>

    <!-- STICKY OVERLAP STACK -->
    <div class="mt-16 overlap-stack">
      {principles.map((p, i) => (
        <div
          class={`overlap-card card ${colors[i]} p-8 md:p-10 relative overflow-hidden`}
          data-reveal="scale"
          data-tilt3d
          style={`--reveal-delay:${i * 0.08}s; z-index:${10 + i};`}
        >
          <div class="tilt-glare"></div>
          <div class="grid md:grid-cols-[auto_1fr] gap-6 md:gap-10 items-start">
            <div>
              <span class="display-hero text-6xl md:text-7xl">{p.num}</span>
              <span class="tag !bg-white mt-3">Prinsip</span>
            </div>
            <div>
              <h3 class="display-section text-2xl md:text-3xl mb-3">{p.title}</h3>
              <p class="text-base md:text-lg leading-relaxed text-[var(--color-ink-soft)] max-w-lg">{p.desc}</p>
              {i === 0 && (
                <div class="mt-5 flex items-center gap-3 text-sm font-bold text-[var(--color-ink-soft)]">
                  <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-white border-2 border-[var(--color-ink)] shadow-[2px_2px_0_0_var(--color-ink)]">☕</span>
                  Ngopi dulu? Boleh banget!
                </div>
              )}
            </div>
          </div>
          <!-- Decorative corner -->
          <span class="absolute right-4 bottom-4 font-[var(--font-display)] text-[8rem] font-bold leading-none text-[var(--color-ink)]/[0.04] select-none" aria-hidden="true">
            {p.num}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>