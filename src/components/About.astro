---
const principles = [
  {
    num: "01",
    title: "Santai, bukan asal",
    desc: "Ngobrolnya santai, tapi outputnya serius dan rapi. Nggak ada setengah-setengah.",
  },
  {
    num: "02",
    title: "Fokus ke hasil",
    desc: "Bukan cuma cantik. Website harus bantu bisnismu — dapat leads, pesanan, kepercayaan.",
  },
  {
    num: "03",
    title: "Cepat itu wajib",
    desc: "Nggak ada yang sabar buka website lemot. Performa sudah jadi harga mati dari awal.",
  },
  {
    num: "04",
    title: "Jujur & jelas",
    desc: "Progress di-update, biaya transparan, tenggat realistis. Nggak ada janji muluk.",
  },
];
const colors = ["!bg-[var(--color-yellow)]", "!bg-[var(--color-green)]", "!bg-[var(--color-pink)]", "!bg-[var(--color-sky)]"];
---

<section id="about" class="py-24 md:py-32">
  <div class="container-site">
    <p class="kicker mb-4" data-reveal>Tentang kita</p>
    <h2 class="display-section text-4xl md:text-5xl" data-scrub data-reveal style="--reveal-delay:0.08s">
      <span class="scrub-mask"><span class="scrub-word">Studio</span></span>{" "}
      <span class="scrub-mask"><span class="scrub-word">kecil,</span></span>{" "}
      <span class="scrub-mask"><span class="scrub-word text-[var(--color-accent)]">hasil</span></span>{" "}
      <span class="scrub-mask"><span class="scrub-word">gede.</span></span>
    </h2>

    <div class="mt-14 grid gap-8 lg:grid-cols-2 lg:gap-14 items-start">
      <!-- Left: sticky -->
      <div class="lg:sticky lg:top-28">
        <div class="card !bg-[var(--color-yellow)] p-8 md:p-10">
          <span class="text-5xl block mb-5" aria-hidden="true">💡</span>
          <p class="display-hero text-3xl md:text-4xl leading-tight">
            Satu studio,<br />
            <span class="text-[var(--color-accent)]">semua bisa.</span>
          </p>
          <p class="mt-6 text-lg leading-relaxed text-[var(--color-ink-soft)]">
            HaloAfid itu studio independen dari Indonesia. Kecil memang, tapi itu justru
            keunggulannya — kamu ngobrol langsung sama yang ngerjain, bukan sama sales.
            Dari website toko, profil desa, sampe sistem kasir: satu tim, satu tanggung jawab.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <span class="tag !bg-white">🇮🇩 Indonesia</span>
            <span class="tag !bg-white">⏱️ Respon cepat</span>
            <span class="tag !bg-white">☕ Ngopi dulu boleh</span>
          </div>
        </div>
      </div>

      <!-- Right: stack cards -->
      <div class="space-y-6">
        {principles.map((p, i) => (
          <div
            class={`card card-hover ${colors[i]} p-7 flex gap-5 items-start`}
            data-reveal
            style={`--reveal-delay:${i * 0.07}s`}
          >
            <span class="display-hero text-3xl font-bold">{p.num}</span>
            <div>
              <h3 class="display-section text-xl mb-1.5">{p.title}</h3>
              <p class="text-sm leading-relaxed text-[var(--color-ink-soft)]">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>