---
const principles = [
  "Simple before complex",
  "Useful over ornamental",
  "Fast by default",
  "Built for real workflows",
];
---

<section id="about" class="py-28 md:py-40">
  <div class="container-site grid lg:grid-cols-12 gap-12">
    <div class="lg:col-span-5">
      <p class="kicker mb-4" data-reveal>ABOUT</p>
      <h2 class="display-section text-text-primary" data-reveal>
        The studio behind the work.
      </h2>
    </div>
    <div class="lg:col-span-7">
      <p class="body-large max-w-2xl mb-12" data-reveal>
        HaloAfid adalah brand digital studio yang menggabungkan desain,
        development, search visibility, dan AI untuk membuat solusi digital
        yang benar-benar dipakai.
      </p>
      <div class="grid sm:grid-cols-2 gap-x-8 gap-y-6 border-t border-line pt-8">
        {
          principles.map((p, i) => (
            <div
              class="flex items-baseline gap-4"
              data-reveal
              style={`transition-delay: ${i * 60}ms`}
            >
              <span class="kicker">{String(i + 1).padStart(2, "0")}</span>
              <p class="text-text-primary font-medium">{p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>