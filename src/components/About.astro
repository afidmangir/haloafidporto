---
const principles = [
  {
    num: "01",
    title: "Santai, bukan asal",
    desc: "Ngobrolnya santai, tapi outputnya serius dan rapi. Nggak ada setengah-setengah.",
  },
  {
    num: "02",
    title: "Fokus ke hasil",
    desc: "Bukan cuma cantik. Website harus bantu bisnismu — dapat leads, pesanan, kepercayaan.",
  },
  {
    num: "03",
    title: "Cepat itu wajib",
    desc: "Nggak ada yang sabar buka website lemot. Performa sudah jadi harga mati dari awal.",
  },
  {
    num: "04",
    title: "Jujur & jelas",
    desc: "Progress di-update, biaya transparan, tenggat realistis. Nggak ada janji muluk.",
  },
];
const colors = ["!bg-[var(--color-yellow)]", "!bg-[var(--color-green)]", "!bg-[var(--color-pink)]", "!bg-[var(--color-sky)]"];
---

<section id="about" class="py-24 md:py-32 pb-0 md:pb-0">
  <div class="container-site">
    <p class="kicker mb-4" data-reveal>Kenapa milih saya</p>
    <h2 class="display-section text-4xl md:text-5xl" data-scrub data-reveal style="--reveal-delay:0.08s">
      <span class="scrub-mask"><span class="scrub-word">Bisnis</span></span>{" "}
      <span class="scrub-mask"><span class="scrub-word">kamu,</span></span>{" "}
      <span class="scrub-mask"><span class="scrub-word text-[var(--color-accent)]">prioritas</span></span>{" "}
      <span class="scrub-mask"><span class="scrub-word">utama.</span></span>
    </h2>
    <div class="mt-6 max-w-xl">
      <p class="text-lg leading-relaxed text-[var(--color-ink-soft)]" data-reveal style="--reveal-delay:0.12s">
        Fokusnya satu: <strong>bantu bisnismu tumbuh</strong> lewat digital.
        Dari website toko, profil desa, sampai sistem kasir — dikerjakan
        tuntas, dengan komunikasi langsung dari yang ngerjain.
      </p>
      <p class="mt-4 text-lg leading-relaxed text-[var(--color-ink-soft)]" data-reveal style="--reveal-delay:0.16s">
        Nggak ada subkon, nggak ada lempar-lemparan. Progress selalu di-update,
        biaya transparan, tenggat realistis. Kamu fokus jualan, sisanya saya urus.
      </p>
    </div>
  </div>

  <!-- STICKY OVERLAP FULL-SCREEN: warna memenuhi layar -->
  <div class="mt-16 overlap-stack-full" data-overlap-full>
    {principles.map((p, i) => (
      <div
        class={`overlap-full ${colors[i]}`}
        data-overlap-card
        style={`z-index:${10 + i};`}
      >
        <div class="overlap-full-inner">
          <div class="grid md:grid-cols-[auto_1fr] gap-6 md:gap-10 items-start">
            <div>
              <span class="display-hero text-7xl md:text-8xl">{p.num}</span>
              <span class="tag !bg-white mt-4">Prinsip</span>
            </div>
            <div class="md:pt-3">
              <h3 class="display-section text-3xl md:text-5xl mb-4">{p.title}</h3>
              <p class="text-lg md:text-xl leading-relaxed text-[var(--color-ink-soft)] max-w-xl">{p.desc}</p>
              {i === 0 && (
                <div class="mt-6 flex items-center gap-3 text-sm font-bold text-[var(--color-ink-soft)]">
                  <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-white border-2 border-[var(--color-ink)] shadow-[2px_2px_0_0_var(--color-ink)]">☕</span>
                  Ngopi dulu? Boleh banget!
                </div>
              )}
            </div>
          </div>
        </div>
        <!-- Decorative corner -->
        <span class="absolute right-4 bottom-2 font-[var(--font-display)] text-[10rem] md:text-[14rem] font-bold leading-none text-[var(--color-ink)]/[0.05] select-none pointer-events-none" aria-hidden="true">
          {p.num}
        </span>
      </div>
    ))}
  </div>
</section>