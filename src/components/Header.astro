---
import { site, nav } from "../data/site";
import LanguageSwitcher from "./LanguageSwitcher.astro";
---

<header class="fixed top-0 inset-x-0 z-50 h-16 md:h-[70px] flex items-center" data-header>
  <div class="container-site w-full h-full">
    <nav class="header-inner flex items-center justify-between h-full rounded-2xl transition-all duration-300" aria-label="Navigasi utama">
      <!-- Logo -->
      <a
        href="#top"
        class="relative flex items-center gap-2.5 font-[var(--font-display)] text-lg font-bold tracking-tight text-[var(--color-ink)]"
        data-magnetic
        aria-label="HaloAfid — kembali ke atas"
      >
        <img src="/assets/haloafid-logo-light.png" alt="HaloAfid" class="h-9 w-auto" loading="eager" />
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center gap-1.5 ml-8">
        {nav.map((item) => (
          <a
            href={item.href}
            class="relative px-3.5 py-2 text-[0.82rem] font-bold text-[var(--color-ink-soft)] border-2 border-transparent rounded-lg transition-all duration-200 hover:text-[var(--color-ink)] hover:border-[var(--color-ink)] hover:bg-white"
            data-nav-link
            data-i18n={`nav.${item.label}`}
          >{item.label}</a>
        ))}
      </div>

      <!-- Right -->
      <div class="flex items-center gap-2.5">
        <div class="hidden md:block">
          <LanguageSwitcher />
        </div>
        <a
          href={site.whatsapp}
          target="_blank"
          rel="noopener"
          class="hidden md:inline-flex items-center gap-2 rounded-xl bg-[var(--color-accent)] border-2 border-[var(--color-ink)] px-5 py-2.5 text-[0.82rem] font-bold text-white shadow-[3px_3px_0_0_var(--color-ink)] transition-all duration-200 hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[5px_5px_0_0_var(--color-ink)]"
          data-magnetic
          data-i18n="nav.Chat"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Chat
        </a>
        <div class="md:hidden">
          <LanguageSwitcher />
        </div>
        <button
          type="button"
          class="md:hidden relative flex h-10 w-10 items-center justify-center rounded-lg border-2 border-[var(--color-ink)] bg-white shadow-[2.5px_2.5px_0_0_var(--color-ink)]"
          data-menu-toggle
          aria-expanded="false"
          aria-label="Buka menu"
        >
          <span class="relative block h-[18px] w-[18px]">
            <span data-menu-line-1 class="absolute left-0 top-0 h-[2px] w-full bg-[var(--color-ink)] transition-all duration-300"></span>
            <span data-menu-line-2 class="absolute bottom-0 left-0 h-[2px] w-full bg-[var(--color-ink)] transition-all duration-300"></span>
          </span>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile menu -->
  <div
    data-mobile-menu
    class="hidden md:hidden fixed inset-0 top-16 z-50 bg-[var(--color-canvas)] flex-col overflow-y-auto"
    aria-hidden="true"
  >
    <nav class="container-site flex-1 flex flex-col py-4">
      {nav.map((item, i) => (
        <a
          href={item.href}
          data-menu-link
          class="flex items-baseline justify-between border-b-2 border-[var(--color-ink)] py-4 text-2xl font-bold tracking-tight text-[var(--color-ink)] hover:text-[var(--color-accent)]"
        >
          <span data-i18n={`nav.${item.label}`}>{item.label}</span>
          <span class="text-xs font-bold text-[var(--color-muted)]">0{i + 1}</span>
        </a>
      ))}
    </nav>
    <div class="container-site pb-8 pt-4">
      <a href={site.whatsapp} target="_blank" rel="noopener" class="flex items-center justify-center gap-2 w-full rounded-xl bg-[var(--color-accent)] border-2 border-[var(--color-ink)] py-3.5 text-sm font-bold text-white shadow-[3px_3px_0_0_var(--color-ink)]" data-menu-link data-i18n="mob.wa">
        💬 Chat WhatsApp
      </a>
    </div>
  </div>
</header>