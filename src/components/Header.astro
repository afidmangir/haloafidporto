---
import { site, nav } from "../data/site";
---

<header class="fixed top-0 inset-x-0 z-50" data-header>
  <div class="container-site">
    <nav
      class="relative flex items-center justify-between"
      aria-label="Navigasi utama"
    >
      <a
        href="#top"
        class="flex items-center gap-2.5 py-4 font-[var(--font-display)] text-lg font-bold tracking-tight"
        data-magnetic
      >
        <span
          class="grid h-9 w-9 place-items-center rounded-xl bg-[var(--color-accent)] text-white text-sm font-bold"
          >h.</span
        >
        <span>HaloAfid</span>
      </a>

      <ul class="hidden md:flex items-center gap-1">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="px-4 py-2 text-sm font-medium text-[var(--color-ink-soft)] hover:text-[var(--color-ink)] link-line"
              >{item.label}</a
            >
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-3">
        <a
          href={site.whatsapp}
          target="_blank"
          rel="noopener"
          class="btn btn-primary hidden md:inline-flex !py-2.5 !px-5 text-sm"
          data-magnetic
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Diskusi via WhatsApp
        </a>

        <button
          type="button"
          class="md:hidden grid h-11 w-11 place-items-center rounded-xl border border-[var(--color-line)] bg-white"
          data-menu-toggle
          aria-expanded="false"
          aria-label="Buka menu navigasi"
        >
          <span class="relative block h-4 w-5">
            <span data-menu-line-1 class="absolute left-0 top-0.5 h-0.5 w-full bg-[var(--color-ink)] transition-all duration-300"></span>
            <span data-menu-line-2 class="absolute left-0 bottom-0.5 h-0.5 w-full bg-[var(--color-ink)] transition-all duration-300"></span>
          </span>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile menu -->
  <div
    data-mobile-menu
    class="hidden md:hidden fixed inset-0 top-[72px] bg-white/95 backdrop-blur-xl flex-col"
    aria-hidden="true"
  >
    <nav class="container-site flex-1 py-10 flex flex-col gap-2">
      {nav.map((item, i) => (
        <a
          href={item.href}
          data-menu-link
          class="display-section flex items-baseline justify-between border-b border-[var(--color-line)] py-5 text-3xl hover:text-[var(--color-accent)]"
          style={`transition-delay:${i * 40}ms`}
        >
          <span>{item.label}</span>
          <span class="text-sm text-[var(--color-muted)]">0{i + 1}</span>
        </a>
      ))}
    </nav>
    <div class="container-site pb-10">
      <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-primary w-full" data-menu-link>
        Diskusi via WhatsApp
      </a>
    </div>
  </div>
</header>